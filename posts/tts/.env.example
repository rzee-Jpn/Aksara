# =====================================================
# TTS Silang — API Keys Configuration
# Salin file ini jadi .env dan isi API key kamu
# =====================================================

# ── DEFAULT (dipakai semua world jika tidak ada per-world) ──
DEFAULT_PROVIDER=anthropic
DEFAULT_API_KEY=sk-ant-xxxxxxxxxxxxx

# ── PER WORLD (opsional, override DEFAULT) ──
# World 1: Pengetahuan Umum
WORLD_W1_PROVIDER=anthropic
WORLD_W1_API_KEY=sk-ant-xxxxxxxxxxxxx

# World 2: Sains & Teknologi (contoh pakai OpenAI)
WORLD_W2_PROVIDER=openai
WORLD_W2_API_KEY=sk-xxxxxxxxxxxxx

# World 3: Budaya Indonesia (contoh pakai Groq — gratis!)
WORLD_W3_PROVIDER=groq
WORLD_W3_API_KEY=gsk_xxxxxxxxxxxxx

# World 4: Hiburan
WORLD_W4_PROVIDER=anthropic
WORLD_W4_API_KEY=sk-ant-xxxxxxxxxxxxx

# ── DAILY PUZZLE ──
DAILY_PROVIDER=groq
DAILY_API_KEY=gsk_xxxxxxxxxxxxx

# =====================================================
# GROQ (gratis, cepat):  https://console.groq.com
# Anthropic:             https://console.anthropic.com
# OpenAI:                https://platform.openai.com
# =====================================================
